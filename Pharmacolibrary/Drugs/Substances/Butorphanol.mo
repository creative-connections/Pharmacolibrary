  annotation (Documentation(info = "<html><body><p>Butorphanol is an opioid painkiller used to treat pain, including migraine, and can also act as a cough suppressant. It is an approved medicine in human and veterinary use, though not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1185089\">Wikidata Q1185089</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>butorphanol</td></tr><tr><td>ATC codes:</td><td>N02AF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00611\">DB00611</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6916249\">6916249</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3242\">3242</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1185089\">Q1185089</a></td></tr><tr><td>formula:</td><td>C21H29NO2</td></tr><tr><td>molar mass:</td><td>327.468 g/mol (PubChem CID 6916249)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
