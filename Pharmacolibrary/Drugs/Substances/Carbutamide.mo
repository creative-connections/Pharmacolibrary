  annotation (Documentation(info = "<html><body><p>Carbutamide is a sulfonylurea that was developed as an anti-diabetic medication to lower blood glucose. It is not an approved medicine today; it is classified as investigational and has no European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5038107\">Wikidata Q5038107</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbutamide</td></tr><tr><td>ATC codes:</td><td>A10BB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13406\">DB13406</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9564\">9564</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135118\">135118</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5038107\">Q5038107</a></td></tr><tr><td>formula:</td><td>C11H17N3O3S</td></tr><tr><td>molar mass:</td><td>271.335 g/mol (PubChem CID 9564)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
