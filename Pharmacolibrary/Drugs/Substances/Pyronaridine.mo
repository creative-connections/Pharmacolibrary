  annotation (Documentation(info = "<html><body><p>Pyronaridine is an antimalarial drug used to treat malaria, available as a combination with an artemisinin derivative. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7263674\">Wikidata Q7263674</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Pyronaridine</td></tr><tr><td>ATC codes:</td><td>P01BF06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12975\">DB12975</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5485198\">5485198</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135951\">135951</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7263674\">Q7263674</a></td></tr><tr><td>formula:</td><td>C29H32ClN5O2</td></tr><tr><td>molar mass:</td><td>518.06 g/mol (knowledgebase (DrugBank calculated))</td></tr></table><h4>Metabolites</h4><table><tr><td><code>Dihydroartemisinin</code></td><td>dihydroartemisinin</td><td>284.352 g/mol (pubchem)</td></tr></table></body></html>"));
