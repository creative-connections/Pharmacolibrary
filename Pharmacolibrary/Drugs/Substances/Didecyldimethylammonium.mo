  annotation (Documentation(info = "<html><body><p>Didecyldimethylammonium is a quaternary ammonium compound used as an antiseptic and disinfectant for the skin. It is an approved topical antiseptic, used mainly in dermatological disinfectant products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418930\">Wikidata Q418930</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Didecyldimethylammonium</td></tr><tr><td>ATC codes:</td><td>D08AJ06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04221\">DB04221</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16958\">16958</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418930\">Q418930</a></td></tr><tr><td>formula:</td><td>C22H48N+</td></tr><tr><td>molar mass:</td><td>326.633 g/mol (PubChem CID 16958)</td></tr></table></body></html>"));
end Didecyldimethylammonium;
