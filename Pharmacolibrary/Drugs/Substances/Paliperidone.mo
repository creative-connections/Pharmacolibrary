  annotation (Documentation(info = "<html><body><p>Paliperidone is an antipsychotic used to treat schizophrenia and other psychotic disorders, including schizoaffective disorder. It is authorised in the European Union and is widely used in psychiatric care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423292\">Wikidata Q423292</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>paliperidone</td></tr><tr><td>ATC codes:</td><td>N05AX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01267\">DB01267</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/115237\">115237</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:83804\">83804</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423292\">Q423292</a></td></tr><tr><td>formula:</td><td>C23H27FN4O3</td></tr><tr><td>molar mass:</td><td>426.492 g/mol (PubChem CID 115237)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table><h4>Metabolites</h4><table><tr><td><code>HydroxyrisperidonePaliperidone9</code></td><td>9-hydroxyrisperidone (paliperidone)</td><td>426.492 g/mol (pubchem)</td></tr></table></body></html>"));
