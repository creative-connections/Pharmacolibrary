  annotation (Documentation(info = "<html><body><p>Sarecycline is a tetracycline antibiotic used to treat acne. It is approved and used clinically, mainly in the United States; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25104592\">Wikidata Q25104592</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sarecycline</td></tr><tr><td>ATC codes:</td><td>J01AA14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12035\">DB12035</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54681908\">54681908</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q25104592\">Q25104592</a></td></tr><tr><td>formula:</td><td>C24H29N3O8</td></tr><tr><td>molar mass:</td><td>487.509 g/mol (PubChem CID 54681908)</td></tr><tr><td>logP:</td><td>1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
