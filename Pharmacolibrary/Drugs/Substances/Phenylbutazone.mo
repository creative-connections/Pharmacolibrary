within Pharmacolibrary.Drugs.Substances;
package Phenylbutazone "phenylbutazone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "phenylbutazone",
    atcCodes = {"M01AA01", "M02AA01"},
    drugbankId = "DB00812",
    pubchemCid = "4781",
    chebiId = "48574",
    wikidataId = "Q421342",
    formula = "C19H20N2O2",
    M = 0.308381,
    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Phenylbutazone is a non-steroidal anti-inflammatory drug that was used to treat pain and inflammatory conditions such as rheumatic disease. It has been withdrawn for human use in most countries because of serious side effects, but it remains approved in veterinary medicine, mainly for horses and dogs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421342\">Wikidata Q421342</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenylbutazone</td></tr><tr><td>ATC codes:</td><td>M01AA01, M02AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00812\">DB00812</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4781\">4781</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:48574\">48574</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421342\">Q421342</a></td></tr><tr><td>formula:</td><td>C19H20N2O2</td></tr><tr><td>molar mass:</td><td>308.381 g/mol (PubChem CID 4781)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Phenylbutazone;
