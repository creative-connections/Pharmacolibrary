  annotation (Documentation(info = "<html><body><p>Belantamab mafodotin, a monoclonal antibody drug conjugate, was used to treat multiple myeloma. It is no longer in use: its marketing authorisation in the European Union has expired, and it is listed as withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q98139657\">Wikidata Q98139657</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>belantamab mafodotin</td></tr><tr><td>ATC codes:</td><td>L01FX15, L01XC39</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15719\">DB15719</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q98139657\">Q98139657</a></td></tr></table><h4>Metabolites</h4><table><tr><td><code>CysMcMMAF</code></td><td>cys-mcMMAF</td><td>1046.33 g/mol (pubchem)</td></tr></table></body></html>"));
